{
  "name": "solarreach-navigator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 4317",
    "precompute": "python3 pipeline/build_dataset.py",
    "standalone": "npm run math:check && node scripts/build-standalone.mjs",
    "build": "npm run math:check && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts tests/*/*.test.ts components/workbench/scene/*.test.ts tests/*/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "terrain": "node scripts/prepare-terrain.mjs",
    "verify:horizons": "tsx scripts/verify-horizons.ts",
    "math:build": "tsx scripts/build-mathml.ts",
    "math:check": "tsx scripts/build-mathml.ts --check",
    "build:web": "npm run math:check && node scripts/build-web.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "3d-tiles-renderer": "0.5.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "satellite.js": "6.0.2",
    "shadcn": "^4.23.0",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "geotiff": "^3.0.5",
    "playwright-core": "1.65.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "temml": "^0.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
